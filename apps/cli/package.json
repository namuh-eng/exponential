{
  "name": "@expn/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Exponential issue tracking.",
  "type": "module",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namuh-eng/exponential.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/namuh-eng/exponential#readme",
  "bugs": {
    "url": "https://github.com/namuh-eng/exponential/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
