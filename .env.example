# =============================================================================
# exponential — Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
#
# RECOMMENDED: use 1Password instead of a local .env. See docs/secrets.md.
#   op signin --account namuhinc.1password.com
#   make dev-op   # wraps `pnpm dev` with secrets from 1Password
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres)
# API and migrator runtime DB contract. Web does not receive database
# credentials in production/self-host runtime; its local dev preflight may read
# DATABASE_URL only to diagnose whether the API database is reachable.
# Default points at docker-compose.dev.yml (host port 15532).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:15532/exponential?sslmode=disable
# Fallback: if DATABASE_URL is unset, the app will build one from these.
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=15532
# DB_NAME=exponential
# DB_SSL=true  # Uncomment for remote/production databases

# -----------------------------------------------------------------------------
# Redis — docker-compose.dev.yml exposes Redis on host port 16379.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:16379

# -----------------------------------------------------------------------------
# Auth + public URLs (first-party Go API)
# Generate secrets with: openssl rand -hex 32
# -----------------------------------------------------------------------------
EXPONENTIAL_SESSION_SECRET=change-me-to-a-random-session-secret
# Required to encrypt third-party integration credentials in provider_credential.
# Generate with: openssl rand -base64 32
EXPONENTIAL_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64-or-hex-key
EXPONENTIAL_PROVIDER_CREDENTIAL_ENCRYPTION_KEY_ID=env:v1
# Required for /metrics/red in production/self-hosted Compose.
EXPONENTIAL_METRICS_TOKEN=change-me-to-a-random-metrics-token
EXPONENTIAL_APP_URL=http://localhost:7015
NEXT_PUBLIC_APP_URL=http://localhost:7015
PUBLIC_BASE_URL=http://localhost:7015
# Internal API URL used by the web process / Next.js rewrite when not set by
# Docker Compose or ECS. Host-local development usually uses localhost.
# EXPONENTIAL_API_URL=http://localhost:7016/v1
# ECS web-to-API URL. Prefer the ALB DNS here so server-side web requests do
# not hairpin through the public CDN/proxy hostname.
# WEB_INTERNAL_API_URL=http://your-alb-dns-name/api

# -----------------------------------------------------------------------------
# Google OAuth (optional — required for "Continue with Google")
# Get credentials at https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# GitHub OAuth (optional — required for "Continue with GitHub")
# Get OAuth app credentials at https://github.com/settings/developers
# -----------------------------------------------------------------------------
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# -----------------------------------------------------------------------------
# AWS — S3 (file uploads), SES (transactional email)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=
# Optional S3-compatible endpoint for MinIO, Cloudflare R2, Garage, etc.
# The Go API forces path-style presigned URLs when this is set.
S3_ENDPOINT=
# For MinIO/local S3-compatible storage, set these to the MinIO root/user
# credentials. For AWS S3 on ECS, prefer the task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Transactional email (Go API)
#
# Required From: address for all providers. With SENDER_EMAIL empty AND no
# other email provider configured, the Go API marks email as disabled —
# magic-link sign-in returns 503 in production and any future email-dependent
# feature is expected to short-circuit. There is no fallback sender.
#
# Provider auto-selection order (first match wins):
#   1. EMAIL_PROVIDER=smtp|ses|opensend  explicit override
#   2. SMTP_HOST set                     → smtp
#   3. OPENSEND_API_KEY set              → opensend
#   4. SENDER_EMAIL set                  → ses
#
# SMTP (plain relay — works with Mailhog, Mailgun, Postmark, Gmail app password,
# or any other SMTP relay):
#   SMTP_HOST        required — relay hostname (e.g. smtp.mailgun.org)
#   SMTP_PORT        optional — defaults to 587 (STARTTLS); use 465 with SMTP_TLS=true
#   SMTP_USERNAME    optional — relay username / API key
#   SMTP_PASSWORD    optional — relay password / API secret
#   SMTP_TLS         optional — set to "true" for implicit TLS on port 465;
#                               omit for STARTTLS (port 587) or plaintext (Mailhog)
#
# Opensend (https://opensend.namuh.co) — set OPENSEND_API_KEY (and optionally
# OPENSEND_BASE_URL for self-hosted deployments).
# -----------------------------------------------------------------------------
SENDER_EMAIL=
# EMAIL_PROVIDER=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=
# OPENSEND_API_KEY=
# OPENSEND_BASE_URL=

# -----------------------------------------------------------------------------
# Docker Compose image tag (docker-compose.images.yml only)
# Defaults to "latest". Pin a release tag to avoid automatic updates:
#   IMAGE_TAG=v1.2.3
# -----------------------------------------------------------------------------
# IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Docker Compose override ports/binds — only needed if defaults conflict.
# docker-compose.yml and docker-compose.dev.yml both default to these host ports.
# -----------------------------------------------------------------------------
# WEB_PORT=7015
# API_PORT=7016
# PG_PORT=15532
# REDIS_PORT=16379
# WEB_BIND=0.0.0.0
# API_BIND=127.0.0.1
# PG_BIND=127.0.0.1
# REDIS_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# TEST_ACCOUNT_EMAIL=test@example.com  # Used by Playwright auth setup

# -----------------------------------------------------------------------------
# AWS ECS deployment (generated by scripts/prepare-ecs-deploy-env.sh and
# scripts/preflight.sh; .env is intentionally gitignored)
# -----------------------------------------------------------------------------
# APP_NAME=exponential
# AWS_ACCOUNT_ID=
# PUBLIC_BASE_URL=https://<your-public-domain>
# PRIVATE_DNS_ZONE=exponential.internal
# PRIVATE_DNS_ZONE_ID=
# DB_INSTANCE_CLASS=db.t3.micro
# DB_MULTI_AZ=false
# REDIS_NODE_TYPE=cache.t3.micro
# REDIS_REPLICATION_ENABLED=false
# ECS_EXECUTION_ROLE_ARN=
# ECS_TASK_ROLE_ARN=
# DATABASE_URL_SECRET_ARN=
# REDIS_URL_SECRET_ARN=
# GOOGLE_CLIENT_ID_SECRET_ARN=
# GOOGLE_CLIENT_SECRET_SECRET_ARN=
# STRIPE_WEBHOOK_SIGNING_SECRET_SECRET_ARN=
# STRIPE_SECRET_KEY_SECRET_ARN=
# STRIPE_CLOUD_TEAM_PRICE_ID=
# STRIPE_CLOUD_BUSINESS_PRICE_ID=
# PRIV_SUBNET_A=
# PRIV_SUBNET_B=
# APP_SG=
# ALB_SG=
# API_TG_ARN=
# WEB_TG_ARN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# EXPONENTIAL_TRUSTED_PROXIES=10.0.0.0/16
